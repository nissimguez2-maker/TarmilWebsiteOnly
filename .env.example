# Mapbox GL access token — powers the planner map.
# Without it the map shows a graceful "needs a token" placeholder. Free tier is
# generous. Create one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Optional Groq API key — rewrites auto-pulled Wikipedia city intros into warmer
# copy. Without it, intros fall back to raw Wikipedia text.
VITE_GROQ_API_KEY=

# Supabase — anonymous server-side trip storage (table web_trips, RLS-scoped to
# the anon auth user). Without these the app runs localStorage-only. Both values
# are public; the anon/publishable key is safe in the client (RLS-protected).
# Requires "Anonymous sign-ins" enabled in the Supabase project's Auth settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
